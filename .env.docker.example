# Copy to .env.docker and replace the required placeholders before starting Compose.
WHYLOWDPS_VERSION=v3.8.0
WHYLOWDPS_HOST_IP=192.168.100.126
WHYLOWDPS_PORT=8000
JWT_SECRET=replace-with-at-least-32-random-characters
SESSION_ENCRYPTION_KEY=replace-with-another-32-random-characters
WHYLOWDPS_BOOTSTRAP_ADMIN_BATTLETAG=YourBattleTag#1234
WHYLOWDPS_SECURE_COOKIES=false
SIMC_CHANNEL=weekly
MAX_CONCURRENT_SIMULATIONS=2
MAX_JOBS_PER_USER=200
