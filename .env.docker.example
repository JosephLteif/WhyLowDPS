# Copy to .env.docker and replace the required placeholders before starting Compose.
WHYLOWDPS_DOMAIN=app.example.com
WEB_ORIGIN=https://app.example.com
BLIZZARD_REDIRECT_URI=https://app.example.com/api/auth/bnet/callback
# Optional: enter these in the hosted app at runtime instead.
# BLIZZARD_CLIENT_ID=replace-me
# BLIZZARD_CLIENT_SECRET=replace-me
JWT_SECRET=replace-with-at-least-32-random-characters
WHYLOWDPS_SECURE_COOKIES=true
SIMC_CHANNEL=weekly
MAX_CONCURRENT_SIMULATIONS=2
MAX_JOBS=200
