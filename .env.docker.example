# Copy to .env.docker and replace the required placeholders before starting Compose.
WHYLOWDPS_VERSION=v3.8.0
WHYLOWDPS_HOST_IP=192.168.100.126
WHYLOWDPS_PORT=8000
# Optional: enter these in the hosted app at runtime instead.
# BLIZZARD_CLIENT_ID=replace-me
# BLIZZARD_CLIENT_SECRET=replace-me
JWT_SECRET=replace-with-at-least-32-random-characters
WHYLOWDPS_SECURE_COOKIES=false
SIMC_CHANNEL=weekly
MAX_CONCURRENT_SIMULATIONS=2
MAX_JOBS=200
