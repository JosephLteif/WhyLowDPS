{$WHYLOWDPS_DOMAIN:localhost} {
    encode gzip zstd
    {$WHYLOWDPS_TLS}

    @hashed_assets path /_next/static/*
    header @hashed_assets Cache-Control "public, max-age=31536000, immutable"
    header /sw.js Cache-Control "no-cache, no-store, must-revalidate"
    header /manifest.webmanifest Cache-Control "no-cache, must-revalidate"

    reverse_proxy app:8000
}
